#!/bin/bash
set -euo pipefail

log() {
  echo "$(date -Iseconds) $*"
}

DATA_DISK="/dev/disk/by-id/google-mc-data-disk"
MOUNT_POINT="/mnt/minecraft"
COMPOSE_DIR="$${MOUNT_POINT}/compose"
SERVER_DIR="$${MOUNT_POINT}/server"
BACKUP_DIR="$${MOUNT_POINT}/backups"
RCON_PASSWORD_FILE="$${MOUNT_POINT}/rcon-password"
TERRAFORM_RCON_PASSWORD="${rcon_password}"
COMPOSE_FILE="$${COMPOSE_DIR}/docker-compose.yml"
PACKWIZ_URL="${packwiz_url}"
DISCORD_WEBHOOK_URL="${discord_webhook_url}"
MC_MEMORY="${mc_memory}"
METRICS_SCRAPE_INTERVAL="${metrics_scrape_interval}"
PURGE_LEGACY_MONITORING_DATA="${purge_legacy_monitoring_data}"
ENABLE_AUTOSTOP="${enable_autostop}"
AUTOSTOP_TIMEOUT_EST="${autostop_timeout_est}"
AUTOSTOP_TIMEOUT_INIT="${autostop_timeout_init}"
BACKUP_INTERVAL="${backup_interval}"
PRUNE_BACKUPS_DAYS="${prune_backups_days}"
CONNECT_ADDRESS="${connect_address}"
MC_METRICS_PORT="19565"
OPS_AGENT_CONFIG_DIR="/etc/google-cloud-ops-agent"
OPS_AGENT_CONFIG_FILE="$${OPS_AGENT_CONFIG_DIR}/config.yaml"
AUTOSTOP_CHECK_SCRIPT="/usr/local/bin/mc-autostop-check.sh"

if [ "$${ENABLE_AUTOSTOP}" = "true" ]; then
  MC_ENABLE_AUTOSTOP="TRUE"
  # AUTOSTOP は「コンテナを終了させる」ことで成立する。unless-stopped のままだと
  # Docker が即座に再起動してしまい、いつまでも止まらない。
  MC_RESTART_POLICY="no"
else
  MC_ENABLE_AUTOSTOP="FALSE"
  MC_RESTART_POLICY="unless-stopped"
fi

log "Starting startup script"

if [ -z "$${PACKWIZ_URL}" ]; then
  log "PACKWIZ_URL is empty; ensure Terraform variable packwiz_url is set" >&2
  exit 1
fi

# Wait for the persistent disk to attach before proceeding.
for _ in $(seq 1 12); do
  if [ -e "$${DATA_DISK}" ]; then
    break
  fi
  log "Waiting for data disk $${DATA_DISK}"
  sleep 5
done

if [ ! -e "$${DATA_DISK}" ]; then
  log "Data disk $${DATA_DISK} not present" >&2
  exit 1
fi

# Format the disk if it has not been formatted yet.
if ! blkid "$${DATA_DISK}" >/dev/null 2>&1; then
  log "Formatting $${DATA_DISK} as ext4"
  mkfs.ext4 -F "$${DATA_DISK}"
fi

mkdir -p "$${MOUNT_POINT}"
if ! mountpoint -q "$${MOUNT_POINT}"; then
  log "Mounting $${DATA_DISK} to $${MOUNT_POINT}"
  mount "$${DATA_DISK}" "$${MOUNT_POINT}"
fi

if ! grep -q "$${DATA_DISK}" /etc/fstab; then
  echo "$${DATA_DISK} $${MOUNT_POINT} ext4 defaults 0 2" >> /etc/fstab
fi

RCON_PASSWORD="$${TERRAFORM_RCON_PASSWORD}"
if [ -z "$${RCON_PASSWORD}" ]; then
  if [ -f "$${RCON_PASSWORD_FILE}" ]; then
    RCON_PASSWORD="$(cat "$${RCON_PASSWORD_FILE}")"
  else
    if command -v openssl >/dev/null 2>&1; then
      RCON_PASSWORD="$(openssl rand -hex 16)"
    else
      RCON_PASSWORD="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32)"
    fi
    echo "$${RCON_PASSWORD}" > "$${RCON_PASSWORD_FILE}"
    chmod 600 "$${RCON_PASSWORD_FILE}"
  fi
else
  echo "$${RCON_PASSWORD}" > "$${RCON_PASSWORD_FILE}"
  chmod 600 "$${RCON_PASSWORD_FILE}"
fi

# アイドル自動停止を入れると VM の起動/停止が日常的に起きる。毎回 Docker を
# 入れ直していると起動のたびに数分待たされるので、入っていればスキップする。
# ブートディスクは stop/start でも preemption でも保持されるため、初回だけ走る。
if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
  log "Docker already installed; skipping install"
else
  log "Configuring Docker apt repository"
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y apt-transport-https ca-certificates curl gnupg lsb-release
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --yes --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod 0644 /etc/apt/keyrings/docker.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list

  log "Installing Docker engine"
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi

systemctl enable docker
systemctl start docker

# --- Cloud Monitoring / Cloud Logging -------------------------------------
# ホストメトリクスとログは Ops Agent が直接 Cloud Monitoring / Cloud Logging に送る。
# Minecraft のメトリクスは Prometheus Exporter mod を Ops Agent が localhost で
# スクレイプして転送する。VM 上に Prometheus / Grafana / node-exporter は置かない。
if ! dpkg -s google-cloud-ops-agent >/dev/null 2>&1; then
  log "Installing Google Cloud Ops Agent"
  curl -fsSL https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh -o /tmp/add-google-cloud-ops-agent-repo.sh
  bash /tmp/add-google-cloud-ops-agent-repo.sh --also-install
  rm -f /tmp/add-google-cloud-ops-agent-repo.sh
else
  log "Ops Agent already installed; skipping install"
fi

mkdir -p "$${OPS_AGENT_CONFIG_DIR}"
cat <<EOF > "$${OPS_AGENT_CONFIG_FILE}"
# Ops Agent はこのユーザー設定を組み込み設定に「マージ」する。
# default_pipeline と別 ID のパイプラインを足すだけなら、組み込みの default_pipeline
# (hostmetrics / syslog) はそのまま動き続ける。止めたい場合だけ default_pipeline を
# receivers: [] で明示的に上書きする。
# https://cloud.google.com/monitoring/agent/ops-agent/configuration
# ここでは Minecraft 固有のメトリクスとログのパイプラインだけを追加する。
metrics:
  receivers:
    minecraft:
      type: prometheus
      config:
        scrape_configs:
          - job_name: minecraft
            scrape_interval: $${METRICS_SCRAPE_INTERVAL}
            static_configs:
              - targets: ["localhost:$${MC_METRICS_PORT}"]
            metric_relabel_configs:
              # mc_* と up 以外（JVM 内部など）は取り込み課金を避けるため送らない
              - source_labels: [__name__]
                regex: "mc_.*|up"
                action: keep
  service:
    pipelines:
      minecraft:
        receivers: [minecraft]
logging:
  receivers:
    minecraft_server:
      type: files
      include_paths:
        - $${SERVER_DIR}/logs/latest.log
  service:
    pipelines:
      minecraft_server:
        receivers: [minecraft_server]
EOF

log "Restarting Ops Agent"
systemctl enable google-cloud-ops-agent
systemctl restart google-cloud-ops-agent

mkdir -p \
  "$${SERVER_DIR}" \
  "$${COMPOSE_DIR}" \
  "$${BACKUP_DIR}"

chown -R 1000:1000 "$${SERVER_DIR}" "$${BACKUP_DIR}"

cat <<EOF > "$${COMPOSE_FILE}"
services:
  minecraft:
    container_name: minecraft-server
    image: itzg/minecraft-server:java21
    restart: "$${MC_RESTART_POLICY}"
    ports:
      - "25565:25565"
      # メトリクスは Ops Agent (ホスト) だけが読む。外部には公開しない。
      - "127.0.0.1:$${MC_METRICS_PORT}:$${MC_METRICS_PORT}"
    environment:
      EULA: "TRUE"
      CREATE_CONSOLE_IN_PIPE: "true"
      OPS: "Prog24"
      TYPE: "NEOFORGE"
      VERSION: "1.21.1"
      MEMORY: "$${MC_MEMORY}"
      USE_PACKWIZ: "true"
      PACKWIZ_URL: "$${PACKWIZ_URL}"
      PACKWIZ_FILTER: "server,both"
      DATAPACKS: |
        https://cdn.modrinth.com/data/ZVzW5oNS/versions/pwe1kTJE/Incendium_1.21_UNSUPPORTED_PORT_v5.4.4.zip
        https://cdn.modrinth.com/data/LPjGiSO4/versions/JuMNLwUQ/Nullscape_1.21_v1.2.14.zip
        https://cdn.modrinth.com/data/8oi3bsk5/versions/urbokcOc/Terralith_1.21_v2.5.8.zip
        https://cdn.modrinth.com/data/h2jngREY/versions/83BCs8t6/Trek%201.19-1.21.11%20B0.5.1.2.zip
      ENABLE_RCON: "true"
      RCON_PASSWORD: "$${RCON_PASSWORD}"
      RCON_PORT: "25575"
      # アイドル自動停止。最後の 1 人が抜けてから EST 秒、誰も来ないまま INIT 秒で
      # サーバーを正常終了させる。コンテナ終了後は mc-autostop.timer が VM を落とす。
      # AUTOPAUSE とは排他なので、両方を有効にしてはいけない。
      ENABLE_AUTOSTOP: "$${MC_ENABLE_AUTOSTOP}"
      AUTOSTOP_TIMEOUT_EST: "$${AUTOSTOP_TIMEOUT_EST}"
      AUTOSTOP_TIMEOUT_INIT: "$${AUTOSTOP_TIMEOUT_INIT}"
    volumes:
      - /mnt/minecraft/server:/data
  mc-backup:
    container_name: minecraft-backup
    image: itzg/mc-backup
    depends_on:
      - minecraft
    environment:
      PUID: "1000"
      PGID: "1000"
      RCON_HOST: "minecraft"
      RCON_PORT: "25575"
      RCON_PASSWORD: "$${RCON_PASSWORD}"
      # 24/7 稼働ではなくなるため、既定の 24h 間隔だとセッション中に 1 度も
      # バックアップが走らない。稼働時間に合わせて短い間隔にしておく。
      BACKUP_INTERVAL: "$${BACKUP_INTERVAL}"
      PRUNE_BACKUPS_DAYS: "$${PRUNE_BACKUPS_DAYS}"
    volumes:
      - /mnt/minecraft/server:/data:ro
      - /mnt/minecraft/backups:/backups
EOF

log "Deploying Docker Compose stack"
docker compose -f "$${COMPOSE_FILE}" pull
log "Starting minecraft stack"
# --remove-orphans で旧 prometheus / grafana / node-exporter を停止・削除する
docker compose -f "$${COMPOSE_FILE}" up -d --remove-orphans

# compose のプロジェクト名が変わっていた場合に備えて、名前でも明示的に掃除する
for legacy in prometheus grafana node-exporter; do
  if docker ps -a --format '{{.Names}}' | grep -qx "$${legacy}"; then
    log "Removing legacy monitoring container $${legacy}"
    docker rm -f "$${legacy}" || true
  fi
done

if [ "$${PURGE_LEGACY_MONITORING_DATA}" = "true" ]; then
  log "Purging legacy Prometheus/Grafana data from the data disk"
  rm -rf \
    "$${MOUNT_POINT}/prometheus" \
    "$${MOUNT_POINT}/grafana" \
    "$${MOUNT_POINT}/grafana-admin-password" \
    "$${COMPOSE_DIR}/prometheus.yml" \
    "$${COMPOSE_DIR}/grafana"
fi

# --- アイドル自動停止: コンテナ終了を検知して VM を落とす -------------------
# ENABLE_AUTOSTOP は Minecraft を止めるだけで VM は課金され続けるので、
# コンテナの終了を監視して poweroff する systemd timer を組にする。
cat <<'AUTOSTOP_CHECK_EOF' > "$${AUTOSTOP_CHECK_SCRIPT}"
${autostop_check_script}
AUTOSTOP_CHECK_EOF
chmod 0755 "$${AUTOSTOP_CHECK_SCRIPT}"

cat <<EOF > /etc/systemd/system/mc-autostop.service
[Unit]
Description=Minecraft コンテナが終了していたら VM を停止する

[Service]
Type=oneshot
ExecStart=$${AUTOSTOP_CHECK_SCRIPT}
EOF

cat <<'EOF' > /etc/systemd/system/mc-autostop.timer
[Unit]
Description=Minecraft のアイドル自動停止チェック

[Timer]
OnActiveSec=1min
OnUnitActiveSec=1min
AccuracySec=10s
Unit=mc-autostop.service

# [Install] は意図的に持たない。
# enable して boot 時から動かすと、前回 AUTOSTOP で終了したコンテナを
# docker compose が起こす前に検知して即 poweroff するループになりうる。
# この起動スクリプトが compose を立ち上げたあとに start するのが唯一の起動経路。
EOF

systemctl daemon-reload
if [ "$${ENABLE_AUTOSTOP}" = "true" ]; then
  log "Enabling idle auto-stop watchdog"
  systemctl restart mc-autostop.timer
else
  log "Idle auto-stop is disabled; stopping watchdog"
  systemctl stop mc-autostop.timer || true
fi

if [ -n "$${DISCORD_WEBHOOK_URL}" ]; then
  log "Preparing Discord notification"
  EXTERNAL_IP="$(curl -sf -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/access-configs/0/external-ip" || true)"
  INSTANCE_NAME="$(curl -sf -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/instance/name" || true)"
  if [ -z "$${INSTANCE_NAME}" ]; then
    INSTANCE_NAME="unknown"
  fi

  if [ -n "$${CONNECT_ADDRESS}" ]; then
    # wake proxy 経由。VM の外部 IP は起動のたびに変わるが、プレイヤーの接続先は
    # 常時稼働のプロキシ側なので変わらない。
    MESSAGE="$(printf 'Minecraftサーバー (%s) が起動しました。接続先: %s' "$${INSTANCE_NAME}" "$${CONNECT_ADDRESS}")"
  elif [ -n "$${EXTERNAL_IP}" ]; then
    MESSAGE="$(printf 'Minecraftサーバー (%s) が起動しました。接続先: %s:25565' "$${INSTANCE_NAME}" "$${EXTERNAL_IP}")"
  else
    MESSAGE="$(printf 'Minecraftサーバー (%s) が起動しました。' "$${INSTANCE_NAME}")"
  fi

  PAYLOAD="$(printf '{"content":"%s"}' "$${MESSAGE}")"
  if ! curl -sf -H "Content-Type: application/json" -d "$${PAYLOAD}" "$${DISCORD_WEBHOOK_URL}"; then
    log "Failed to send Discord notification" >&2
  else
    log "Sent Discord notification"
  fi
fi

log "Startup script completed"
